# Ostendic site build: environment variables (read by `node build/build.mjs`).
# The site is generated to static HTML, so these values are baked in at build time.

# Calendly scheduling page used by /book and every "Book a quick call" button.
# Leave unset to use the default below.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/harshkdubeyhd

# Web3Forms access key for the contact form. Create one at https://web3forms.com
# with the inbox that should receive enquiries. It is a public key by design.
# Vercel runs `node build/build.mjs` on every deploy (vercel.json), so this
# can be set in Vercel's environment variables; site.formKey is the fallback.
WEB3FORMS_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Admin panel (/admin). Set these in Vercel > Project > Settings >
# Environment Variables (Production). Never commit real values.

# The one password for /admin. Use a long, unique one (20+ characters).
ADMIN_PASSWORD=

# GitHub fine-grained personal access token that lets the panel save content:
# github.com > Settings > Developer settings > Fine-grained tokens >
# repository access: only WebsiteMain; permissions: Contents = Read and write.
# Each save commits content/blog.json or content/home.json, and Vercel
# redeploys the site from that commit (about a minute).
GITHUB_TOKEN=

# Optional: the repo and branch the panel commits to (defaults shown).
GITHUB_REPO=harshaiagentsworkspace-sudo/WebsiteMain
GITHUB_BRANCH=main

# Optional: extra secret mixed into the session cookie signature. Changing it
# (or ADMIN_PASSWORD) signs everyone out.
ADMIN_SESSION_SECRET=

# Local development: `node build/serve.mjs` runs the panel in local mode
# (saves to content/*.json on disk and rebuilds). Password: ADMIN_PASSWORD
# if set, otherwise "ostendic-local".
