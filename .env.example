# Ostendic site build: environment variables (read by `node build/build.mjs`).
# The site is generated to static HTML, so these values are baked in at build time.

# Calendly scheduling page used by /book and every "Book a quick call" button.
# Leave unset to use the default below.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/harshkdubeyhd

# Web3Forms access key for the contact form. Create one at https://web3forms.com
# with the inbox that should receive enquiries. It is a public key by design.
# Vercel serves the committed HTML without a build, so for production also set
# it as site.formKey in build/data.mjs (or build with this variable) and commit.
WEB3FORMS_ACCESS_KEY=
