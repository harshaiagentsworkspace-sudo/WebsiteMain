# Ostendic site build: environment variables (read by `node build/build.mjs`).
# The site is generated to static HTML, so these values are baked in at build time.

# Calendly scheduling page used by /book and every "Book a quick call" button.
# Leave unset to use the default below.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/harshkdubeyhd
